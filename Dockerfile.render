# Pulse render service: screenshots draft dashboards for the agent (see render/README.md).
#
# Debian-based rather than UBI: Chromium's system libraries are not in the UBI
# repositories. Only Playwright's headless Chromium shell is installed.
FROM node:22-bookworm-slim

ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright \
    NODE_ENV=production \
    HOME=/tmp

WORKDIR /app
# playwright-core is pinned exactly and has no dependencies, so this install is
# deterministic without a lockfile (the repo uses pnpm and ignores npm locks).
COPY render/package.json ./
RUN npm install --omit=dev --no-audit --no-fund \
 && npx playwright install --with-deps --only-shell chromium \
 && rm -rf /var/lib/apt/lists/* /root/.npm \
 && chmod -R a+rX /ms-playwright

COPY render/app.mjs render/render.mjs render/server.mjs ./

# Any UID works (OpenShift assigns one); nothing is written outside /tmp.
USER 1001
EXPOSE 8090
CMD ["node", "server.mjs"]
